{
  "info": {
    "name": "E3 - Salud y Auth",
    "description": "API local real; credenciales y tokens mediante variables. Ejecutar con pnpm test:salud-auth para generar cuentas temporales y limpiar los datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "url_backend",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Salud y errores generales",
      "item": [
        {
          "name": "S-01 Salud p?blica",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{url_backend}}/api/v1/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Sin contrase?as ni hashes', () => { const text = pm.response.text(); pm.expect(text).not.to.include(pm.environment.get('test_password')); pm.expect(text).not.to.include('password_hash'); });",
                  "pm.test('Estado ok', () => pm.expect(pm.response.json().estado).to.eql('ok'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "S-02 Ruta inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{url_backend}}/api/v1/no-existe-e3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Error informado sin token', () => { const data = pm.response.json(); pm.expect(data.error).to.be.a('string').and.not.empty; pm.expect(data).not.to.have.property('token'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "S-03 JSON mal formado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{url_backend}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{invalido",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Error informado sin token', () => { const data = pm.response.json(); pm.expect(data.error).to.be.a('string').and.not.empty; pm.expect(data).not.to.have.property('token'); });"
                ]

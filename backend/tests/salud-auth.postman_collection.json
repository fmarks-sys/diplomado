            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "P-01 Login v?lido de bibliotecario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{url_backend}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{bibliotecario_username}}\",\"password\":\"{{test_password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Token JWT', () => pm.expect(pm.response.json().token).to.match(/^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/));",
                  "pm.test('Rol BIBLIOTECARIO', () => pm.expect(pm.response.json().user.rol).to.eql('BIBLIOTECARIO'));",
                  "if (pm.response.code === 200) pm.environment.set('token_bibliotecario', pm.response.json().token);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "P-02 Contrase?a incorrecta",
